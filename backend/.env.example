DATABASE_URL=sqlite:///./school_sis.db
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173"]
FINANCIAL_HOLD_ENABLED=true
FINANCIAL_HOLD_THRESHOLD_AMOUNT=0
FINANCIAL_HOLD_GRACE_DAYS=0
# --- الإنتاج (انظر ../.env.production.example و../DEPLOYMENT.md) ---
# ENVIRONMENT=production يفعّل رفض الإقلاع بمفتاح ضعيف ويعطّل /docs
ENVIRONMENT=development
ALLOW_BOOTSTRAP_REGISTRATION=true
# للتطوير المحلي على Supabase بدل SQLite (انظر ../.env.production.example للشرح الكامل):
#DATABASE_URL='postgresql://postgres.<REF>:<ENCODED_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres'
