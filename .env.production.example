# =====================================================================================
# إعدادات الإنتاج — انسخ هذا الملف إلى .env (cp .env.production.example .env) ثم عدّل القيم.
# لا ترفع .env إلى Git أبدًا (مُستثنى في .gitignore). صلاحياته: chmod 600 .env
# =====================================================================================

# ---- النطاق والشهادات --------------------------------------------------------------
# النطاق الذي يشير سجلّ DNS (A) الخاص به إلى عنوان الخادم، بدون https://
DOMAIN=school.example.com
# بريد تنبيهات Let's Encrypt (انتهاء الشهادة...)
LETSENCRYPT_EMAIL=admin@example.com

# ---- قاعدة البيانات: Supabase (PostgreSQL مُدار) ------------------------------------
# من لوحة Supabase: افتح المشروع ← زر Connect (أعلى الصفحة) ← Connection String ← Type: URI
#   Method = "Transaction pooler"  ⇒ DATABASE_URL            (المنفذ 6543، لتشغيل التطبيق)
#   Method = "Session pooler"      ⇒ MIGRATION_DATABASE_URL  (المنفذ 5432، للـ migrations)
# استبدل [YOUR-PASSWORD] بكلمة مرور قاعدة البيانات **مرمَّزة** (URL-encoded)، ثم الصق الرابط.
# (التفاصيل والصور النصية في DEPLOYMENT.md ← «إعداد Supabase».)
#
# ⚠️ ضع الرابط بين علامتي اقتباس مفردتين '...': يحوي & و$ وغيرها يفسّرها Docker Compose والـ shell.
# ⚠️ لا تستخدم الاتصال المباشر db.<ref>.supabase.co على VPS عادي: عنوانه IPv6 فقط وDocker لا يدعمه
#    افتراضيًا (يظهر "Network is unreachable"). استخدم المجمّعات (pooler) كما أعلاه.
#
# ترميز كلمة المرور (أمر واحد، ثم الصق الناتج مكان [YOUR-PASSWORD]):
#     python3 -c "import urllib.parse,getpass; print(urllib.parse.quote(getpass.getpass('password: '), safe=''))"
# الأفضل: كلمة مرور هيكس بلا رموز خاصة (openssl rand -hex 24) تضبطها في Settings ← Database ← Reset password.
#
# يُضاف sslmode=require تلقائيًا لمضيفات supabase.co/.com، ويُحوَّل postgresql:// إلى مشغّل psycopg تلقائيًا.
DATABASE_URL='postgresql://postgres.YOUR_PROJECT_REF:ENCODED_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?sslmode=require'
MIGRATION_DATABASE_URL='postgresql://postgres.YOUR_PROJECT_REF:ENCODED_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require'

# حجم تجمّع الاتصالات لكل عملية gunicorn. الإجمالي = BACKEND_REPLICAS × WEB_CONCURRENCY × (POOL + OVERFLOW)
# (الافتراضي 2×2×5 = 20 اتصالًا) — يجب أن يبقى أقل بكثير من حد اتصالات خطتك في Supabase.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# ---- (بديل اختياري) قاعدة PostgreSQL محلية في Docker بدل Supabase ----------------------
# فعّل السطرين التاليين وعدّل الرابط ليشير إلى الخدمة المحلية db (يستهلك ذاكرة إضافية على الخادم):
#COMPOSE_PROFILES=localdb
#POSTGRES_DB=school_sis
#POSTGRES_USER=school
#POSTGRES_PASSWORD=CHANGE_ME_run__openssl_rand_-hex_24
#DATABASE_URL='postgresql://school:CHANGE_ME_run__openssl_rand_-hex_24@db:5432/school_sis'
#MIGRATION_DATABASE_URL=''

# ---- مفتاح التوقيع (JWT + رموز التحقق من السندات) -----------------------------------
# إلزامي في الإنتاج: الخادم يرفض الإقلاع إن كان ضعيفًا/افتراضيًا/أقصر من 32 حرفًا.
# ولّده مرة واحدة واحفظه في مدير كلمات مرور. تغييره لاحقًا يُسجِّل خروج كل المستخدمين
# ويُبطل رموز QR للسندات القديمة.
#     openssl rand -hex 32
#   أو: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_run__openssl_rand_-hex_32

# ---- الجلسات والتسجيل --------------------------------------------------------------
# مدة صلاحية رمز الدخول بالدقائق (480 = 8 ساعات)
ACCESS_TOKEN_EXPIRE_MINUTES=480
# false في الإنتاج: يُنشأ المدير الأول بالأمر
#   docker compose exec backend python scripts/create_admin.py --email you@school.iq --name "المدير"
ALLOW_BOOTSTRAP_REGISTRATION=false

# ---- الحجب المالي لشهادات أولياء الأمور ------------------------------------------------
FINANCIAL_HOLD_ENABLED=true
# تُحجب الشهادة إذا تجاوز مجموع الأقساط المتأخرة هذا المبلغ (بالدينار). 0 = أي قسط متأخر
FINANCIAL_HOLD_THRESHOLD_AMOUNT=0
# أيام سماح بعد تاريخ الاستحقاق قبل اعتبار القسط سببًا للحجب
FINANCIAL_HOLD_GRACE_DAYS=0

# ---- الأداء والنسخ -----------------------------------------------------------------
# عدد نسخ الـ backend (2 يتيح النشر المتدرّج بلا توقف) وعدد عمال gunicorn لكل نسخة
BACKEND_REPLICAS=2
FRONTEND_REPLICAS=2
WEB_CONCURRENCY=2

# ---- نسخ احتياطي (backup.sh / deploy.sh) — يعمل مع Supabase ومع القاعدة المحلية --------------------------------------------
# عدد النسخ المحلية المحفوظة (الأقدم يُحذف)
BACKUP_KEEP=14
# إصدار عميل pg_dump المستخدم مع Supabase: يجب أن يساوي أو يفوق إصدار PostgreSQL في مشروعك (Settings ← Infrastructure)
PG_CLIENT_IMAGE=postgres:17-alpine

# ---- اختياري: صور بديلة (خوادم خلف مرآة/Registry خاص) ---------------------------------
#PYTHON_IMAGE=python:3.13-slim
#NODE_IMAGE=node:22-alpine
#FRONTEND_NGINX_IMAGE=nginxinc/nginx-unprivileged:1.27-alpine
